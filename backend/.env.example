GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Supabase project (see ../supabase/migrations). Used only to verify incoming
# access tokens against the project's public JWKS — no service-role key needed
# for that. Must match the frontend's EXPO_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co

CORS_ORIGINS=*

LOG_LEVEL=INFO
LOG_JSON=false

WEATHER_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
HTTP_TIMEOUT_SECONDS=10
GEOCODE_CACHE_TTL_SECONDS=3600
GEOCODE_CACHE_SIZE=256

RATE_LIMIT_PER_MINUTE=60

API_PREFIX=/api/v1
