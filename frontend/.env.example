# Base URL of the backend API (see ../backend). No trailing slash, no /api/v1 suffix.
#
# - iOS simulator / web:  http://localhost:8000
# - Android emulator:     http://10.0.2.2:8000
# - Physical device:      http://<your-machine-LAN-IP>:8000  (phone and dev machine must share a network)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project (see ../supabase/migrations). The publishable key is safe to
# expose client-side — RLS policies on the database gate what it can actually
# read or write, not the key itself. Find both in the Supabase dashboard under
# Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
